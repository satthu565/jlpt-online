{
  "name": "@jlpt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --loader ts-node/esm src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run -c ../../tests/vitest.config.ts --testTimeout=30000 --hookTimeout=30000",
    "test:auth": "vitest run src/modules/auth/auth.test.ts",
    "test:authorization": "vitest run src/common/guards/authorization.test.ts",
    "test:attempts": "vitest run src/modules/attempt/attempt.test.ts",
    "test:no-answer-leak": "vitest run src/modules/attempt/no-answer-leak.test.ts",
    "test:jobs": "vitest run src/modules/outbox/jobs.test.ts",
    "test:content": "vitest run src/modules/question-bank/ src/modules/license/",
    "test:upload": "vitest run src/modules/media/",
    "test:storage": "vitest run src/modules/storage/",
    "test:import-jobs": "vitest run src/modules/import/import-jobs.test.ts",
    "test:import-limit": "vitest run src/modules/import/import-body-limit.test.ts",
    "test:publish": "vitest run src/modules/exam/publish.test.ts",
    "test:practice-api": "vitest run src/modules/exam/practice-api.test.ts",
    "test:explanations": "vitest run src/modules/review/explanations.test.ts",
    "test:notifications": "vitest run src/modules/notification/notifications.test.ts",
    "test:classrooms": "vitest run src/modules/classroom/classroom.test.ts",
    "test:events": "vitest run src/modules/classroom/event.test.ts",
    "test:community": "vitest run src/modules/community/community.test.ts",
    "test:privacy": "vitest run src/modules/user/privacy.test.ts",
    "test:security": "vitest run --testTimeout=30000 --hookTimeout=30000 src/common/guards/security-hardening.test.ts src/common/guards/authorization.test.ts src/modules/attempt/no-answer-leak.test.ts",
    "test:api:all": "vitest run -c ../../tests/vitest.config.ts --testTimeout=30000 --hookTimeout=30000",
    "demo:seed": "node dist/src/modules/import/demo-seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fastify/static": "10.1.2",
    "@jlpt/config": "workspace:*",
    "@jlpt/content-tools": "workspace:*",
    "@jlpt/exam-engine": "workspace:*",
    "@jlpt/media-token": "workspace:*",
    "@jlpt/schema": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "better-auth": "1.7.9",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "eslint": "9.21.0",
    "typescript": "5.8.2",
    "vitest": "5.0.4"
  }
}
