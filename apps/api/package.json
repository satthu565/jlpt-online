{
  "name": "@jlpt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --loader ts-node/esm src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=20000",
    "test:auth": "vitest run src/modules/auth/auth.test.ts",
    "test:authorization": "vitest run src/common/guards/authorization.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fastify/static": "10.1.2",
    "@jlpt/config": "workspace:*",
    "@jlpt/schema": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "better-auth": "1.7.9",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "eslint": "9.21.0",
    "typescript": "5.8.2",
    "vitest": "5.0.4"
  }
}
