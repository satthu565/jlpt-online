{
  "schemaVersion": 1,
  "scope": "ALL_V1_V4",
  "workerCount": 6,
  "coordinatorInstances": 1,
  "coordinator": {
    "repo": "jlpt-coordinator (repo riêng, không nằm trong repo sản phẩm)",
    "builtBefore": "day 0",
    "spec": "DAC_TA_RUNNER.md"
  },
  "locks": {
    "repo-root": "File cấu hình gốc của monorepo",
    "dependency-lock": "pnpm-lock.yaml và package manifests; worker gửi yêu cầu thêm thư viện, coordinator gộp thành bước ngắn có khóa",
    "schema-contract": "packages/schema, contracts/, api-client sinh tự động",
    "db-migration": "Migration journal và schema DB",
    "engine-contract": "API công khai của packages/exam-engine",
    "ui-contract": "Component và token dùng chung trong packages/ui",
    "ci-workflow": ".github/workflows",
    "staging-deploy": "Môi trường staging dùng chung",
    "heavy-load": "Cửa sổ chạy load test riêng",
    "api-hardening": "Đợt sửa bảo mật chạm nhiều module API"
  },
  "cli": "gemini",
  "authMode": "native-per-worker-login",
  "credentialsEmbedded": false,
  "limits": {
    "activeWork": 6,
    "activeReviews": 1,
    "heavyBuilds": 2,
    "browserSuites": 1,
    "loadRuns": 1
  },
  "taskCatalog": "../tasks.json",
  "inputMode": "PREPARED_IMPORT_V2_NO_OCR",
  "stateStore": "SQLite WAL (implementation required)",
  "productionAccess": false,
  "quotaPolicy": "pause-only-affected-worker; checkpoint; never silently rotate identity",
  "workers": [
    {
      "id": "W1",
      "role": "Hợp đồng dữ liệu và logic thi",
      "linuxUser": "jlpt-w1",
      "repo": "/srv/jlpt-workers/w1/repo",
      "home": "/home/jlpt-w1",
      "nativeLogin": "operator-required",
      "allowedRoots": [
        "packages/schema/",
        "packages/exam-engine/",
        "packages/media-token/",
        "packages/srs/",
        "packages/api-client/",
        "contracts/",
        "fixtures/contracts/",
        "apps/api/src/db/",
        "docs/decisions/"
      ],
      "database": "jlpt_w1",
      "redisCoreNamespace": "jlpt:w1:core:",
      "redisCacheNamespace": "jlpt:w1:cache:",
      "bullmqPrefix": "jlpt-w1",
      "storageRoot": "/srv/jlpt-workers/w1/data",
      "ports": {
        "web": 3100,
        "admin": 3101,
        "api": 4100
      },
      "canReadOtherWorkerCredentials": false,
      "canReadCoordinatorSecrets": false
    },
