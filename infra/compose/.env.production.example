# Production Environment Template (Values injected via secrets / operator)
# Never commit real credentials to git!

IMAGE_TAG=latest
IMAGE_REPO=jlpt

# Profile: small (default) or large
PROFILE=small

# Application URLs
APP_URL=https://example.com
ADMIN_URL=https://admin.example.com
API_URL=https://example.com/api/v1
MEDIA_URL=https://media.example.com

# PostgreSQL Database
POSTGRES_USER=jlpt
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_DB=jlpt_prod
DATABASE_URL=postgres://jlpt:replace_with_strong_production_password@postgres:5432/jlpt_prod

# Redis URLs (internal docker network)
REDIS_CORE_URL=redis://redis-core:6379
REDIS_CACHE_URL=redis://redis-cache:6379

# Internal Service Interconnects (A12)
API_INTERNAL_URL=http://api:4000
WEB_INTERNAL_URL=http://web:3000

# Auth & Media Secrets
AUTH_SECRET=replace_with_64_char_auth_secret
MEDIA_TOKEN_SECRET=replace_with_64_char_media_token_secret

# Cloudflare R2 / S3 & WAL-G Backup Settings
WALG_S3_PREFIX=s3://jlpt-backups/prod
R2_ACCESS_KEY_ID=replace_with_r2_key
R2_SECRET_ACCESS_KEY=replace_with_r2_secret
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_S3_FORCE_PATH_STYLE=true

# Email & Observability
RESEND_API_KEY=re_live_replace_me
SENTRY_DSN=https://example@sentry.io/12345
TURNSTILE_SECRET_KEY=0x4AAAAAA...
