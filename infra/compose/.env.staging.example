# Staging Environment Template (Used for Staging and PR Drill Verification)
# Ensures strict data isolation from production and worker development environments.

IMAGE_TAG=staging-latest
IMAGE_REPO=jlpt

# Profile: small (Linode Shared 4GB or CI runner)
PROFILE=small

# Application URLs
APP_URL=http://127.0.0.1:3000
ADMIN_URL=http://127.0.0.1:3001
API_URL=http://127.0.0.1:4000/api/v1
MEDIA_URL=http://127.0.0.1:8787

# PostgreSQL Database (Staging isolated database)
POSTGRES_USER=jlpt
POSTGRES_PASSWORD=staging_secure_password_isolated
POSTGRES_DB=jlpt_staging
DATABASE_URL=postgres://jlpt:staging_secure_password_isolated@postgres:5432/jlpt_staging

# Redis URLs (internal docker network)
REDIS_CORE_URL=redis://redis-core:6379
REDIS_CACHE_URL=redis://redis-cache:6379

# Internal Service Interconnects (A12)
API_INTERNAL_URL=http://api:4000
WEB_INTERNAL_URL=http://web:3000

# Auth & Media Secrets
AUTH_SECRET=staging_auth_secret_fixed_for_reproducible_smoke_tests
MEDIA_TOKEN_SECRET=staging_media_token_secret_for_reproducible_smoke_tests

# Cloudflare R2 / S3 & WAL-G Backup Settings (Isolated staging bucket prefix)
WALG_S3_PREFIX=s3://jlpt-backups/staging
R2_ACCESS_KEY_ID=staging_mock_r2_key
R2_SECRET_ACCESS_KEY=staging_mock_r2_secret
R2_ENDPOINT=http://127.0.0.1:9000
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_S3_FORCE_PATH_STYLE=true

# Email & Observability
RESEND_API_KEY=re_staging_mock
SENTRY_DSN=
TURNSTILE_SECRET_KEY=0x4AAAAAAABkMYinukMG3447
