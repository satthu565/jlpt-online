# JLPT Online - Large Profile (Dedicated 8GB RAM G6 Linode / Exam Season) per Contract A12

PROFILE=large

# Application Memory Limits & V8 heap
WEB_MEM_LIMIT=1024m
WEB_MAX_OLD_SPACE=768

ADMIN_MEM_LIMIT=512m
ADMIN_MAX_OLD_SPACE=384

API_MEM_LIMIT=1280m
API_MAX_OLD_SPACE=384
API_WORKERS=3

WORKER_MEM_LIMIT=512m
WORKER_MAX_OLD_SPACE=384

# Database & Cache Memory Limits
POSTGRES_MEM_LIMIT=2560m
POSTGRES_CONFIG_FILE=/etc/postgresql/postgresql.large.conf

REDIS_CORE_MEM_LIMIT=320m
REDIS_CORE_MAXMEMORY=256mb

REDIS_CACHE_MEM_LIMIT=320m
REDIS_CACHE_MAXMEMORY=256mb
