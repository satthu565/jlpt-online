# JLPT Online - Small Profile (Shared 4GB RAM Linode / Staging) per Contract A12

PROFILE=small

# Application Memory Limits & V8 heap
WEB_MEM_LIMIT=448m
WEB_MAX_OLD_SPACE=320

ADMIN_MEM_LIMIT=320m
ADMIN_MAX_OLD_SPACE=256

API_MEM_LIMIT=512m
API_MAX_OLD_SPACE=384
API_WORKERS=1

WORKER_MEM_LIMIT=320m
WORKER_MAX_OLD_SPACE=256

# Database & Cache Memory Limits
POSTGRES_MEM_LIMIT=1024m
POSTGRES_CONFIG_FILE=/etc/postgresql/postgresql.small.conf

REDIS_CORE_MEM_LIMIT=160m
REDIS_CORE_MAXMEMORY=128mb

REDIS_CACHE_MEM_LIMIT=96m
REDIS_CACHE_MAXMEMORY=64mb
