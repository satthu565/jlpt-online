# JLPT demo: one origin per app so the browser reaches the API at /api/v1 from any host (LAN, Tailscale, mshome).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 3000;
  client_max_body_size 150m;
  location /api/ { proxy_pass http://127.0.0.1:4000; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-For $remote_addr; }
  location = /auth/verify-email { proxy_pass http://127.0.0.1:4000/api/v1/auth/verify-email$is_args$args; proxy_set_header Host $http_host; }
  location /mail/ { proxy_pass http://127.0.0.1:8025; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $http_host; }
  location / { proxy_pass http://127.0.0.1:13200; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $http_host; }
}

server {
  listen 3001;
  client_max_body_size 150m;
  location /api/ { proxy_pass http://127.0.0.1:4000; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-For $remote_addr; }
  location / { proxy_pass http://127.0.0.1:13303; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $http_host; }
}
