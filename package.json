{
  "name": "jlpt-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1 -- --fileParallelism=false",
    "test:import-contracts": "vitest run packages/content-tools/tests/import-contracts.test.ts",
    "test:import-validation": "vitest run packages/content-tools/tests/import-validation.test.ts",
    "test:import-jobs": "vitest run apps/api/src/modules/import/import-jobs.test.ts",
    "test:publish": "vitest run apps/api/src/modules/exam/publish.test.ts",
    "demo:seed": "pnpm --filter @jlpt/api build && node apps/api/dist/src/modules/import/demo-seed.js",
    "test:nlp": "vitest run packages/content-tools/tests/nlp.test.ts",
    "test:vocab-data": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/vocab/vocab.test.ts",
    "import:validate": "node tools/import-data/bin/validate.js",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "infra:dev:check": "node --no-warnings --experimental-strip-types infra/dev/check.ts",
    "test:vps": "pnpm --filter @jlpt/tests test:vps",
    "contracts:check": "pnpm --filter @jlpt/schema build && node -e \"import('./packages/schema/dist/index.js').then(m => m.runCheck(process.cwd()))\"",
    "contracts:generate": "pnpm --filter @jlpt/schema build && node -e \"import('./packages/schema/dist/index.js').then(m => m.runGenerate(process.cwd()))\" && pnpm --filter @jlpt/api-client build",
    "test:contracts": "vitest run packages/schema/tests packages/api-client/tests",
    "db:migrate:test": "vitest run apps/api/src/db/db.test.ts -t \"migrates a fresh database\"",
    "db:seed:test": "vitest run apps/api/src/db/db.test.ts -t \"seeds fresh migrated database\"",
    "test:db": "vitest run apps/api/src/db/db.test.ts",
    "test:auth": "vitest run apps/api/src/modules/auth/auth.test.ts",
    "test:authorization": "vitest run apps/api/src/common/guards/authorization.test.ts",
    "test:attempts": "vitest run apps/api/src/modules/attempt/attempt.test.ts",
    "test:no-answer-leak": "vitest run apps/api/src/modules/attempt/no-answer-leak.test.ts",
    "test:jobs": "vitest run apps/api/src/modules/outbox/jobs.test.ts",
    "test:content": "vitest run apps/api/src/modules/question-bank/ apps/api/src/modules/license/",
    "test:upload": "vitest run apps/api/src/modules/media/",
    "test:storage": "vitest run apps/api/src/modules/storage/",
    "test:exam-engine": "vitest run packages/exam-engine",
    "test:mix:property": "vitest run packages/exam-engine/tests/mix-property.test.ts",
    "test:practice-engine": "vitest run packages/exam-engine/tests/practice-engine.test.ts",
    "test:media-token": "vitest run packages/media-token",
    "test:coverage": "vitest run --coverage --coverage.include=\"packages/exam-engine/src/**\" --coverage.include=\"packages/media-token/src/**\" packages/exam-engine packages/media-token",
    "test:admin": "vitest run -c apps/admin/vitest.config.ts apps/admin",
    "test:admin-auth": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/auth.test.ts apps/admin/tests/guard.test.ts",
    "test:web": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test",
    "test:i18n": "pnpm --filter @jlpt/web test:i18n",
    "test:a11y": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/ui test:a11y && pnpm --filter @jlpt/web test:a11y",
    "test:exam-ui": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test:exam-ui",
    "test:sync": "pnpm --filter @jlpt/web test:sync",
    "test:rich-text": "pnpm --filter @jlpt/ui test:rich-text",
    "test:admin-content": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/content.test.ts",
    "test:admin-users": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/users.test.ts",
    "test:srs": "vitest run packages/srs/tests",
    "test:difficulty": "vitest run packages/exam-engine/tests/difficulty.test.ts",
    "test:dedupe": "vitest run packages/exam-engine/tests/dedupe.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "9.21.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.21.0",
    "prettier": "3.5.3",
    "turbo": "2.11.8",
    "typescript": "5.8.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
