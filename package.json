{
  "name": "jlpt-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --no-warnings --experimental-strip-types apps/api/src/common/utils/monorepo-test-runner.ts",
    "test:import-contracts": "vitest run packages/content-tools/tests/import-contracts.test.ts",
    "test:import-validation": "vitest run packages/content-tools/tests/import-validation.test.ts",
    "test:import-jobs": "vitest run apps/api/src/modules/import/import-jobs.test.ts",
    "test:publish": "vitest run apps/api/src/modules/exam/publish.test.ts",
    "demo:seed": "pnpm --filter @jlpt/api build && node apps/api/dist/src/modules/import/demo-seed.js",
    "test:nlp": "vitest run packages/content-tools/tests/nlp.test.ts",
    "test:vocab-data": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/vocab/vocab.test.ts",
    "import:validate": "node tools/import-data/bin/validate.js",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test:media-edge": "pnpm --filter @jlpt/media-token build && vitest run apps/media-worker/tests",
    "infra:check": "node --no-warnings --experimental-strip-types infra/check-infra.ts",
    "infra:dev:check": "node --no-warnings --experimental-strip-types infra/dev/check.ts",
    "test:vps": "pnpm --filter @jlpt/tests test:vps",
    "contracts:check": "pnpm --filter @jlpt/schema build && node -e \"import('./packages/schema/dist/index.js').then(m => m.runCheck(process.cwd()))\"",
    "contracts:generate": "pnpm --filter @jlpt/schema build && node -e \"import('./packages/schema/dist/index.js').then(m => m.runGenerate(process.cwd()))\" && pnpm --filter @jlpt/api-client build",
    "test:contracts": "vitest run packages/schema/tests packages/api-client/tests",
    "db:migrate:test": "vitest run apps/api/src/db/db.test.ts -t \"migrates a fresh database\"",
    "db:seed:test": "vitest run apps/api/src/db/db.test.ts -t \"seeds fresh migrated database\"",
    "test:db": "vitest run apps/api/src/db/db.test.ts",
    "test:auth": "vitest run apps/api/src/modules/auth/auth.test.ts",
    "test:authorization": "vitest run apps/api/src/common/guards/authorization.test.ts",
    "test:attempts": "vitest run apps/api/src/modules/attempt/attempt.test.ts",
    "test:no-answer-leak": "vitest run apps/api/src/modules/attempt/no-answer-leak.test.ts",
    "test:jobs": "vitest run apps/api/src/modules/outbox/jobs.test.ts",
    "test:content": "vitest run apps/api/src/modules/question-bank/ apps/api/src/modules/license/",
    "test:upload": "vitest run apps/api/src/modules/media/",
    "test:storage": "vitest run apps/api/src/modules/storage/",
    "test:exam-engine": "vitest run packages/exam-engine",
    "test:mix:property": "vitest run packages/exam-engine/tests/mix-property.test.ts",
    "test:practice-engine": "vitest run packages/exam-engine/tests/practice-engine.test.ts",
    "test:media-token": "vitest run packages/media-token",
    "test:engines:all": "vitest run packages/exam-engine packages/srs packages/media-token",
    "test:exports": "vitest run packages/exam-engine/tests/score-report.test.ts packages/exam-engine/tests/exports.test.ts",
    "test:coverage": "vitest run --coverage --coverage.include=\"packages/exam-engine/src/**\" --coverage.include=\"packages/media-token/src/**\" packages/exam-engine packages/media-token",
    "test:admin": "vitest run -c apps/admin/vitest.config.ts apps/admin",
    "test:admin-auth": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/auth.test.ts apps/admin/tests/guard.test.ts",
    "test:web": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test",
    "test:i18n": "pnpm --filter @jlpt/web test:i18n",
    "test:seo": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test:seo",
    "test:performance": "pnpm --filter @jlpt/schema build && pnpm --filter @jlpt/exam-engine build && pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web build && pnpm --filter @jlpt/web test:performance",
    "test:e2e:web-all": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test:e2e:web-all",
    "test:device": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test:device",
    "test:a11y": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/ui test:a11y && pnpm --filter @jlpt/web test:a11y",
    "test:exam-ui": "pnpm --filter @jlpt/ui build && pnpm --filter @jlpt/web test:exam-ui",
    "test:sync": "pnpm --filter @jlpt/web test:sync",
    "test:rich-text": "pnpm --filter @jlpt/ui test:rich-text",
    "test:admin-content": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/content.test.ts",
    "test:admin-users": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/users.test.ts",
    "test:srs": "vitest run packages/srs/tests",
    "test:difficulty": "vitest run packages/exam-engine/tests/difficulty.test.ts",
    "test:dedupe": "vitest run packages/exam-engine/tests/dedupe.test.ts",
    "test:e2e:exam": "vitest run -c apps/web/vitest.config.ts apps/web/tests/e2e-exam.test.tsx",
    "test:e2e:library": "vitest run -c apps/web/vitest.config.ts apps/web/tests/e2e-library.test.tsx",
    "test:practice-api": "vitest run apps/api/src/modules/exam/practice-api.test.ts",
    "test:explanations": "vitest run apps/api/src/modules/review/explanations.test.ts",
    "test:notifications": "vitest run apps/api/src/modules/notification/notifications.test.ts",
    "test:learning": "vitest run apps/api/src/modules/learning/",
    "test:planner": "vitest run apps/api/src/modules/planner/",
    "test:analytics-data": "pnpm --filter @jlpt/schema build && pnpm --filter @jlpt/exam-engine build && vitest run apps/api/src/modules/stats/",
    "test:payments": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/payment/payment.test.ts",
    "test:entitlements": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/entitlement/entitlement.test.ts",
    "test:payment-provider": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/payment/payment-provider.test.ts",
    "test:admin-billing": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/billing.test.ts",
    "test:e2e:learning": "vitest run -c apps/web/vitest.config.ts apps/web/tests/e2e-learning.test.tsx",
    "test:e2e:advanced": "pnpm --filter @jlpt/ui build && vitest run -c apps/web/vitest.config.ts apps/web/tests/e2e-advanced.test.tsx",
    "test:e2e:checkout": "vitest run -c apps/web/vitest.config.ts apps/web/tests/e2e-checkout.test.tsx",
    "test:analytics": "vitest run -c apps/web/vitest.config.ts apps/web/tests/analytics.test.tsx",
    "test:e2e:import-publish": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/e2e-import-publish.test.ts",
    "test:content-review": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/content-review.test.ts",
    "test:ai": "vitest run apps/api/src/modules/ai/ai.test.ts",
    "test:providers:live": "vitest run apps/api/src/modules/ai/provider/providers-live.test.ts",
    "test:learning:all": "vitest run apps/api/src/modules/learning/ apps/api/src/modules/ai/learning-workflow.test.ts",
    "test:gamification": "vitest run apps/api/src/modules/gamification/gamification.test.ts",
    "test:dataset-export": "vitest run packages/content-tools/tests/dataset-export.test.ts apps/api/src/modules/vocab/dataset-export.test.ts",
    "test:classrooms": "vitest run apps/api/src/modules/classroom/classroom.test.ts",
    "test:events": "vitest run apps/api/src/modules/classroom/event.test.ts",
    "test:community": "vitest run apps/api/src/modules/community/community.test.ts",
    "test:privacy": "vitest run apps/api/src/modules/user/privacy.test.ts",
    "test:admin-full": "vitest run -c apps/admin/vitest.config.ts apps/admin",
    "test:reporting": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/reporting/reporting.test.ts",
    "test:cms": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/cms/cms.test.ts",
    "test:experiments": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/experiment/experiment.test.ts",
    "test:e2e:core": "vitest run -c tests/vitest.config.ts tests/e2e/core.test.ts",
    "test:e2e:all-browsers": "vitest run -c tests/vitest.config.ts tests/e2e/all-browsers.test.ts --testTimeout=60000 --hookTimeout=60000",
    "test:security": "node --no-warnings --experimental-strip-types apps/api/src/common/utils/security-test-runner.ts",
    "test:integration:learning": "vitest run -c tests/vitest.config.ts tests/integration/learning/ --testTimeout=60000 --hookTimeout=60000",
    "test:integration:billing": "vitest run -c tests/vitest.config.ts tests/integration/billing/ --testTimeout=60000 --hookTimeout=60000",
    "test:load": "node --no-warnings --experimental-strip-types tests/load/stepped-load-runner.ts",
    "test:load:baseline": "node --no-warnings --experimental-strip-types tests/load/baseline-runner.ts",
    "test:api:all": "pnpm --filter @jlpt/schema build && vitest run -c tests/vitest.config.ts apps/api",
    "test:e2e:admin-all": "vitest run -c apps/admin/vitest.config.ts apps/admin/tests/e2e-admin-all.test.tsx",
    "test:reconciliation": "vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/payment/reconciliation.test.ts && vitest run --testTimeout=60000 --hookTimeout=60000 apps/api/src/modules/reporting/reporting-reconciliation.test.ts && vitest run -c apps/admin/vitest.config.ts apps/admin/tests/reconciliation.test.ts",
    "test:e2e:full": "vitest run -c tests/vitest.config.ts tests/e2e/full/ --fileParallelism=false --testTimeout=60000 --hookTimeout=60000",
    "features:verify": "node --no-warnings --experimental-strip-types infra/features-verify.ts",
    "test:release": "vitest run -c tests/vitest.config.ts tests/integration/release-acceptance.test.ts",
    "check:no-mock-ui": "node --no-warnings --experimental-strip-types tests/integration/check-no-mock-ui.ts",
    "test:e2e:integration": "node tests/playwright/runner.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "9.21.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.21.0",
    "prettier": "3.5.3",
    "turbo": "2.11.8",
    "typescript": "5.8.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
