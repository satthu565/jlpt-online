{
  "name": "jlpt-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:import-contracts": "vitest run packages/content-tools/tests/import-contracts.test.ts",
    "test:import-validation": "vitest run packages/content-tools/tests/import-validation.test.ts",
    "import:validate": "node tools/import-data/bin/validate.js",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test:media-edge": "vitest run apps/media-worker/tests",
    "infra:check": "node --no-warnings --experimental-strip-types infra/check-infra.ts",
    "infra:dev:check": "node --no-warnings --experimental-strip-types infra/dev/check.ts",
    "test:vps": "pnpm --filter @jlpt/tests test:vps",
    "contracts:check": "pnpm --filter @jlpt/schema build && node -e \"import('./packages/schema/dist/index.js').then(m => m.runCheck(process.cwd()))\"",
    "contracts:generate": "pnpm --filter @jlpt/schema build && node -e \"import('./packages/schema/dist/index.js').then(m => m.runGenerate(process.cwd()))\" && pnpm --filter @jlpt/api-client build",
    "test:contracts": "vitest run packages/schema/tests packages/api-client/tests",
    "db:migrate:test": "vitest run apps/api/src/db/db.test.ts -t \"migrates a fresh database\"",
    "db:seed:test": "vitest run apps/api/src/db/db.test.ts -t \"seeds fresh migrated database\"",
    "test:db": "vitest run apps/api/src/db/db.test.ts",
    "test:auth": "vitest run apps/api/src/modules/auth/auth.test.ts",
    "test:authorization": "vitest run apps/api/src/common/guards/authorization.test.ts",
    "test:exam-engine": "vitest run packages/exam-engine",
    "test:media-token": "vitest run packages/media-token",
    "test:coverage": "vitest run --coverage --coverage.include=\"packages/exam-engine/src/**\" --coverage.include=\"packages/media-token/src/**\" packages/exam-engine packages/media-token",
    "test:admin": "vitest run apps/admin",
    "test:admin-auth": "vitest run apps/admin/tests/auth.test.ts apps/admin/tests/guard.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "9.21.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.21.0",
    "prettier": "3.5.3",
    "turbo": "2.11.8",
    "typescript": "5.8.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
