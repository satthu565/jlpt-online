{
  "name": "@jlpt/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@jlpt/schema": "workspace:*"
  },
  "devDependencies": {
    "@jlpt/config": "workspace:*",
    "@types/node": "22.13.10",
    "eslint": "9.21.0",
    "tsup": "9.0.0",
    "typescript": "5.8.2",
    "vitest": "5.0.4"
  }
}
