{
  "name": "@jlpt/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "vitest run tests/a11y.test.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@jlpt/schema": "workspace:*"
  },
  "devDependencies": {
    "@jlpt/config": "workspace:*",
    "@types/node": "22.13.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.8.2",
    "vitest": "5.0.4"
  }
}
