{
  "name": "@jlpt/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run -c vitest.config.ts integration/ --testTimeout=30000 --hookTimeout=60000",
    "test:vps": "vitest run -c vitest.config.ts integration/dac-ta-runner.test.ts",
    "test:e2e:core": "vitest run -c vitest.config.ts e2e/core.test.ts --testTimeout=30000 --hookTimeout=60000",
    "test:e2e:all-browsers": "vitest run -c vitest.config.ts e2e/all-browsers.test.ts --testTimeout=60000 --hookTimeout=60000",
    "test:security": "vitest run -c vitest.config.ts integration/security-matrix.test.ts --testTimeout=30000 --hookTimeout=60000",
    "test:integration:learning": "vitest run -c vitest.config.ts integration/learning/ --testTimeout=60000 --hookTimeout=60000",
    "test:integration:billing": "vitest run -c vitest.config.ts integration/billing/ --testTimeout=60000 --hookTimeout=60000",
    "test:load": "node --no-warnings --experimental-strip-types load/stepped-load-runner.ts",
    "test:load:baseline": "node --no-warnings --experimental-strip-types load/baseline-runner.ts",
    "test:e2e:full": "vitest run -c vitest.config.ts e2e/full/ --fileParallelism=false --testTimeout=60000 --hookTimeout=60000",
    "test:release": "vitest run -c vitest.config.ts integration/release-acceptance.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@jlpt/config": "workspace:*",
    "@jlpt/content-tools": "workspace:*",
    "@jlpt/exam-engine": "workspace:*",
    "@jlpt/media-token": "workspace:*",
    "@jlpt/schema": "workspace:*",
    "@jlpt/srs": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/k6": "2.3.0",
    "@types/node": "22.13.10",
    "drizzle-orm": "0.45.4",
    "eslint": "9.21.0",
    "typescript": "5.8.2",
    "vitest": "5.0.4"
  }
}
