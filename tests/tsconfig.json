{
  "extends": "@jlpt/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "types": ["node", "k6"],
    "paths": {
      "@jlpt/ui": ["../packages/ui/src/index.tsx"],
      "@jlpt/exam-engine": ["../packages/exam-engine/src/index.ts"],
      "@jlpt/content-tools": ["../packages/content-tools/src/index.ts"],
      "@jlpt/media-token": ["../packages/media-token/src/index.ts"],
      "@jlpt/srs": ["../packages/srs/src/index.ts"],
      "@jlpt/schema": ["../packages/schema/src/index.ts"]
    }
  },
  "include": ["integration/**/*", "load/**/*", "e2e/**/*", "playwright/**/*", "playwright.config.ts"]
}
